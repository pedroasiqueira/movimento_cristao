{
  "name": "movimento-cristao-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "deploy": "aws s3 sync dist/ s3://movimento-cristao-web --delete",
    "deploy-cloud": "aws s3 sync dist/ s3://movimento-cristao-web --delete --cache-control \"public, max-age=31536000, immutable\" --exclude \"index.html\" && aws s3 cp dist/index.html s3://movimento-cristao-web/index.html --cache-control \"no-cache, no-store, must-revalidate\" --content-type \"text/html\" && aws cloudfront create-invalidation --distribution-id SUBSTITUIR --paths \"/*\""
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.1.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^6.30.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "vite": "^7.1.7"
  }
}
